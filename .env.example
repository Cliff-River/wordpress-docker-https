# 复制本文件为 .env 后再修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me
HTTP_PORT=80
HTTPS_PORT=443
# 自签名证书的域名（运行 ./generate-certs.sh 时读取）
SERVER_NAME=localhost
# WordPress 基础镜像版本与站点语言（构建镜像时使用）
WORDPRESS_VERSION=7.1.5
WP_LANG=zh_CN
